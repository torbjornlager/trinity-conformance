      "id": "MC-028",
      "title": "URI quoted text in a monitor target denotes the same local actor",
      "transport": "query",
      "goal": "spawn(receive({finish->true}),P),(integer(P)->Id=P;P=Id@_),monitor(Id@\"localhost\",R),monitor(P,Other),R\\==Other,send(P,finish),receive({down(P,R,true)->true},[timeout(2),on_timeout(throw(missing_text_monitor))]),receive({down(P,Other,true)->true},[timeout(2),on_timeout(throw(missing_atom_monitor))])"
    },
