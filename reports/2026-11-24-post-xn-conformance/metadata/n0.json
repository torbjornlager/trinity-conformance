{
  "admission": {
    "max_call_requests_per_window": 120,
    "max_inflight_calls": 3,
    "rate_identity": "principal",
    "rate_window_seconds": 60,
    "window_policy": "fixed"
  },
  "auth": "open",
  "auth_boundary": "trusted_headers",
  "description": "Discovery hub. Probes the other nodes and serves the register as query relations.",
  "implementation": "SWI-Prolog",
  "internal_transport_principal_prefix": "node:",
  "principal_execution": true,
  "principal_id": "[REDACTED]",
  "profile": "relation",
  "provides": [
    "node_auth/2",
    "node_card/6",
    "node_directory_row/10",
    "node_id/1",
    "node_implementation/2",
    "node_profile/2",
    "node_profile_at_least/2",
    "node_provides/2",
    "node_record/2",
    "node_self_contained/2",
    "node_service/2",
    "node_status/2",
    "node_url/2"
  ],
  "sandbox": "blacklist",
  "self_contained": true,
  "self_url": "https://n0.elfenbenstornet.se",
  "services": [
    "registry"
  ],
  "trusted_capability_headers": [
    "X-Web-Prolog-Capabilities",
    "X-Web-Prolog-Caps"
  ],
  "trusted_identity_headers": [
    "X-Web-Prolog-User",
    "X-Web-Prolog-Principal",
    "X-Authenticated-User"
  ],
  "tutorial_sections": [
    "all"
  ],
  "version": "11.0.0",
  "ws_allowed_origins": []
}
