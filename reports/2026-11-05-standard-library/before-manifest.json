{
  "suite": "standard-library-0.1",
  "baseline": "standard-library-0.1",
  "status": "draft",
  "scope": "supporting",
  "minimum_profile": "isobase",
  "contract": "Appendix B standard library: documented arities, relational modes, callback scope, binding and solution semantics; selected formal errors. No complete ISO certification.",
  "source": "lib_eq1(X).\nlib_eq2(X,X).\nlib_eq3(X,X,X).\nlib_eq4(X,X,X,X).\nlib_eq5(X,X,X,X,X).\nlib_eq6(X,X,X,X,X,X).\nlib_eq7(X,X,X,X,X,X,X).\nlib_choice(a,1). lib_choice(a,2). lib_choice(b,3).\nlib_fold(A,S,T):-T is S+A.\nlib_fold2(A,B,S,T):-T is S+A+B.\nlib_fold3(A,B,C,S,T):-T is S+A+B+C.\nlib_fold_choice(X,S,T):-member(T,[X,S]).\nlib_throw(X):-throw(X).\n",
  "cases": [
    {
      "id": "STDLIB-001",
      "title": "member enumerates in order including duplicates",
      "transport": "query",
      "goal": "findall(X,member(X,[a,b,a]),[a,b,a])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-002",
      "title": "member preserves nonground term sharing",
      "transport": "query",
      "goal": "member(pair(X,X),[pair(Y,Z)]),var(X),X==Y,Y==Z",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-003",
      "title": "memberchk commits to the first matching element",
      "transport": "query",
      "goal": "findall(X,memberchk(X,[a,b]),[a])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-004",
      "title": "memberchk preserves matching variable sharing",
      "transport": "query",
      "goal": "memberchk(pair(X,X),[pair(Y,Z),other]),var(X),X==Y,Y==Z",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-005",
      "title": "memberchk fails when no member matches",
      "transport": "query",
      "goal": "\\+memberchk(c,[a,b])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-006",
      "title": "memberchk reports a list type error",
      "transport": "query",
      "goal": "catch(memberchk(a,wrong),error(type_error(list,wrong),_),Caught=true),Caught==true",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-007",
      "title": "append enumerates every split",
      "transport": "query",
      "goal": "findall(A-B,append(A,B,[a,b]),[[]-[a,b],[a]-[b],[a,b]-[]])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-008",
      "title": "append constructs a list",
      "transport": "query",
      "goal": "append([a],[b,c],L),L==[a,b,c]",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-009",
      "title": "length constructs a proper list",
      "transport": "query",
      "goal": "length(L,3),L=[A,B,C],var(A),var(B),var(C),A\\==B,B\\==C",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-010",
      "title": "length measures a list",
      "transport": "query",
      "goal": "length([a,b,c],N),N==3",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-011",
      "title": "select enumerates occurrences in order",
      "transport": "query",
      "goal": "findall(X-R,select(X,[a,b,a],R),[a-[b,a],b-[a,a],a-[a,b]])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-012",
      "title": "nth0 enumerates zero-based positions",
      "transport": "query",
      "goal": "findall(N-X,nth0(N,[a,b],X),[0-a,1-b])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-013",
      "title": "nth1 enumerates one-based positions",
      "transport": "query",
      "goal": "findall(N-X,nth1(N,[a,b],X),[1-a,2-b])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-014",
      "title": "nth0 four-argument form removes an element",
      "transport": "query",
      "goal": "nth0(1,[a,b,c],X,R),X==b,R==[a,c]",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-015",
      "title": "nth1 four-argument form constructs an element",
      "transport": "query",
      "goal": "nth1(2,L,b,[a,c]),L==[a,b,c]",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-016",
      "title": "nth0 four-argument form enumerates positions",
      "transport": "query",
      "goal": "findall(N-X-R,nth0(N,[a,b],X,R),[0-a-[b],1-b-[a]])",
      "requirements": [
        "B-331"
      ]
    },
    {
      "id": "STDLIB-017",
      "title": "between enumerates a closed interval",
      "transport": "query",
      "goal": "findall(N,between(-1,1,N),[-1,0,1])",
      "requirements": [
        "B-332"
      ]
    },
    {
      "id": "STDLIB-018",
      "title": "between tests its output",
      "transport": "query",
      "goal": "between(1,3,2),\\+between(1,3,4)",
      "requirements": [
        "B-332"
      ]
    },
    {
      "id": "STDLIB-019",
      "title": "succ supports both integer directions",
      "transport": "query",
      "goal": "succ(2,Y),Y==3,succ(X,3),X==2",
      "requirements": [
        "B-332"
      ]
    },
    {
      "id": "STDLIB-020",
      "title": "maplist/2 applies a private predicate to corresponding elements",
      "transport": "query",
      "goal": "maplist(lib_eq1,[a,b])",
