    {
      "id": "STDLIB-034",
      "title": "maplist preserves callback nondeterminism",
      "transport": "query",
      "goal": "findall(L,maplist(lib_choice,[a,a],L),[[1,1],[1,2],[2,1],[2,2]])",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-035",
      "title": "maplist supports partial application",
      "transport": "query",
      "goal": "maplist(lib_eq3(a),[a,a],L),L==[a,a]",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-036",
      "title": "maplist fails on unequal list lengths",
      "transport": "query",
      "goal": "\\+maplist(lib_eq2,[a],[a,b])",
      "requirements": [
