        "B-334"
      ]
    },
    {
      "id": "STDLIB-037",
      "title": "maplist propagates the callback exception",
      "transport": "query",
      "goal": "catch(maplist(lib_throw,[library_boom]),library_boom,Caught=true),Caught==true",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
