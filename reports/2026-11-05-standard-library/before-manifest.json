      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-046",
      "title": "call_nth fails past the final solution",
      "transport": "query",
      "goal": "\\+call_nth(member(_,[a,b]),3)",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-047",
