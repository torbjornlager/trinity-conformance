      "id": "STDLIB-038",
      "title": "maplist does not bind an uninstantiated closure on error",
      "transport": "query",
      "goal": "catch(maplist(G,[a]),error(instantiation_error,_),Caught=true),Caught==true,var(G)",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-039",
      "title": "foldl/4 threads its accumulator",
      "transport": "query",
      "goal": "foldl(lib_fold,[1,2,3],0,N),N==6",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-040",
      "title": "foldl/5 threads its accumulator across two lists",
      "transport": "query",
      "goal": "foldl(lib_fold2,[1,2],[3,4],0,N),N==10",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-041",
      "title": "foldl/6 threads its accumulator across three lists",
      "transport": "query",
      "goal": "foldl(lib_fold3,[1,2],[3,4],[5,6],0,N),N==21",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-042",
      "title": "foldl accepts empty lists and preserves the initial value",
      "transport": "query",
      "goal": "foldl(lib_fold,[],pair(X,X),R),R=pair(A,B),var(X),X==A,A==B",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-043",
      "title": "foldl preserves callback alternatives",
      "transport": "query",
      "goal": "findall(R,foldl(lib_fold_choice,[a,b],zero,R),[b,a,b,zero])",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-044",
      "title": "call_nth enumerates solutions from one",
      "transport": "query",
      "goal": "findall(X-N,call_nth(member(X,[a,b,a]),N),[a-1,b-2,a-3])",
      "requirements": [
