      "title": "countall counts duplicate solutions without exporting bindings",
      "transport": "query",
      "goal": "countall(member(X,[a,b,a]),N),N==3,var(X)",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-049",
      "title": "countall of failure is zero",
      "transport": "query",
      "goal": "countall(fail,N),N==0",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-050",
      "title": "countall has one result",
      "transport": "query",
      "goal": "findall(N,countall(member(_,[a,b]),N),[2])",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-051",
      "title": "countall checks a prebound output",
      "transport": "query",
      "goal": "countall(member(_,[a,b]),2),\\+countall(member(_,[a,b]),3)",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
    {
      "id": "STDLIB-052",
      "title": "countall propagates exceptions without binding its output",
      "transport": "query",
      "goal": "catch(countall(throw(library_boom),N),library_boom,Caught=true),Caught==true,var(N)",
      "requirements": [
        "B-333",
        "B-334"
      ]
    },
