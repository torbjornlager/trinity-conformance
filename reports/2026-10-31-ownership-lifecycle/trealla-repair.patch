+
+## Submitted termination authority
+
+Public `exit/2` calls now check inherited client ownership before local or
+remote dispatch, including calls from submitted goals. Legitimate same-scope
+and node-owner operations remain available; standalone local library use is
+unrestricted. See [the policy and regression scope](docs/ACTOR_EXIT_AUTHORITY.md).
+The new shared ownership/lifecycle pack covers independent observers and
+connection teardown; earlier wire-command checks did not cover this path.
diff --git a/actor_authority.pl b/actor_authority.pl
new file mode 100644
index 0000000..cc9365e
--- /dev/null
+++ b/actor_authority.pl
@@ -0,0 +1,60 @@
+% SPDX-License-Identifier: MIT
+:- module(actor_authority, [check_exit/1, open_namespace/2, close_namespace/1]).
+
+% Ownership policy for public hosted actors. The core calls a policy hook
+% before either local termination or distribution routing. Trusted unscoped
+% callers retain the standalone library API. A connection/account identifier
+% is not an exit capability for actors in another client namespace.
+:- use_module(actors, []).
+:- use_module(auth_policy, [principal_has_capability/2]).
+:- multifile actors:hook_check_exit/1.
+actors:hook_check_exit(Pid) :- actor_authority:check_exit(Pid).
+:- dynamic owner_namespace/1, closed_owner_namespace/1.
+:- op(200, xfx, @).
+
+open_namespace(Namespace, Principal) :-
+    (principal_has_capability(Principal, admin) ->
+        with_mutex('$actor_registry', assertz(owner_namespace(Namespace)))
+    ; true).
+
+close_namespace(Namespace) :-
+    with_mutex('$actor_registry',
+        (owner_namespace(Namespace) ->
+            assertz(closed_owner_namespace(Namespace)), prune_closed_owners
+        ; true)).
+
+% Cached HTTP producers may outlive their request; preserve their authority
+% until their final actor retires. The authority table never authorizes an
+% ordinary namespace, even when it has the same principal/account name.
+prune_closed_owners :-
+    forall((closed_owner_namespace(Namespace),
+            \+ actors:actor_namespace(_,Namespace)),
+           (retractall(owner_namespace(Namespace)),
+            retractall(closed_owner_namespace(Namespace)))).
+
+:- multifile actors:hook_stop/1.
+actors:hook_stop(_) :-
+    with_mutex('$actor_registry', actor_authority:prune_closed_owners).
+
+check_exit(Pid) :-
+    actors:current_actor_namespace(Namespace),
+    (Namespace == none -> true
+    ; namespace_owner(Namespace) -> true
+    ; owned_target(Namespace, Pid) -> true
+    ; actors:logical_pid(Pid), \+ actors:actor_thread(Pid,_),
+      \+ actors:actor_namespace(Pid,_) -> true
+    ; throw(error(permission_error(exit,actor,Pid),
+                  context(actors:exit/2,'target is outside the caller ownership tree')))).
+
+namespace_owner(Namespace) :- owner_namespace(Namespace), !.
+namespace_owner(ws_lineage(Relay,_)) :-
+    actors:actor_namespace(Relay,Base), owner_namespace(Base).
+
+owned_target(Namespace, Pid) :-
+    actors:actor_namespace(Pid,Namespace), !.
+% Remote linked work belongs to its local parent's client scope. Distribution
+% still performs the receiver-side command check; a known route alone does
+% not authorize a different local namespace to use that route for exit.
+owned_target(Namespace, Pid) :-
+    nonvar(Pid), Pid = _@_,
+    actors:link(Parent,Pid), actors:actor_namespace(Parent,Namespace), !.
diff --git a/actor_authority_tests.pl b/actor_authority_tests.pl
new file mode 100644
index 0000000..7fc3feb
--- /dev/null
+++ b/actor_authority_tests.pl
@@ -0,0 +1,60 @@
+% SPDX-License-Identifier: MIT
+:- module(actor_authority_tests, [actor_authority_tests/0]).
+:- use_module(actors).
+:- use_module(actor_authority, []).
+:- op(200, xfx, @).
+
+actor_authority_tests :-
+    foreign_exit_is_denied,
+    owner_exit_is_allowed,
+    trusted_exit_is_allowed,
+    remote_route_is_not_authority,
+    writeln('Actor exit authority: all regressions passed').
+
+ready_worker(Parent) :-
+    self(Me), send(Parent,ready(Me)),
+    receive({probe(Who)->send(Who,alive),ready_worker_wait(Parent)}).
+ready_worker_wait(_) :- receive({stop->true}).
+
+make_worker(Namespace, Pid) :-
+    self(Self),
+    actors:with_actor_namespace(Namespace,
+        spawn((self(Me),send(Self,ready(Me)),receive({probe(Who)->send(Who,alive),receive({stop->true})})),Pid,[monitor(true)])),
+    receive({ready(Pid)->true},[timeout(2),on_timeout(throw(no_readiness))]).
+
+foreign_exit_is_denied :-
+    make_worker(ws_client(authority_owner),Pid),
+    catch((actors:with_actor_namespace(ws_client(authority_stranger),
+                                      actors:exit(Pid,forbidden)), Outcome=returned),
+          Error,Outcome=thrown),
+    Outcome==thrown,nonvar(Error),Error=error(permission_error(exit,actor,Pid),_),
+    self(Self),send(Pid,probe(Self)),
+    receive({alive->true},[timeout(2),on_timeout(throw(target_was_affected))]),
+    actors:with_actor_namespace(ws_client(authority_owner),exit(Pid,owner_done)),
+    receive({down(Pid,Pid,owner_done)->true},[timeout(2),on_timeout(throw(no_owner_exit))]).
+
+owner_exit_is_allowed :-
+    make_worker(ws_client(authority_target),Pid),
+    actor_authority:open_namespace(ws_client(authority_admin),principal(admin,[admin])),
+    call_cleanup(
+        actors:with_actor_namespace(ws_client(authority_admin),exit(Pid,admin_done)),
+        actor_authority:close_namespace(ws_client(authority_admin))),
+    receive({down(Pid,Pid,admin_done)->true},[timeout(2),on_timeout(throw(no_admin_exit))]).
+
+trusted_exit_is_allowed :-
+    make_worker(ws_client(authority_trusted_target),Pid),
+    exit(Pid,trusted_done),
+    receive({down(Pid,Pid,trusted_done)->true},[timeout(2),on_timeout(throw(no_trusted_exit))]).
+
+remote_route_is_not_authority :-
+    self(Self),
+    Remote=1234567890@'http://authority.invalid',
+    setup_call_cleanup(
+        (assertz(actors:actor_namespace(Self,ws_client(remote_owner))),
+         assertz(actors:link(Self,Remote))),
+        (actors:with_actor_namespace(ws_client(remote_owner),actor_authority:check_exit(Remote)),
+         catch((actors:with_actor_namespace(ws_client(remote_stranger),
+                    actor_authority:check_exit(Remote)),Outcome=returned),E,Outcome=thrown),
+         Outcome==thrown,nonvar(E),E=error(permission_error(exit,actor,Remote),_)),
+        (retractall(actors:link(Self,Remote)),
+         retractall(actors:actor_namespace(Self,ws_client(remote_owner))))).
