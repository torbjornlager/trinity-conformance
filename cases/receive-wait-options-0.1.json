      "requirements": [
        "B-106"
      ]
    },
    {
      "id": "RW-002",
      "title": "A nonnumeric deadline raises a catchable type error",
      "transport": "query",
      "goal": "catch((receive({never->true},[deadline(not_a_time)]),fail),error(type_error(_,not_a_time),_),true)",
      "requirements": [
        "B-107"
      ]
    },
    {
      "id": "RW-003",
      "title": "Timeout precedence does not suppress a malformed deadline error",
      "transport": "query",
      "goal": "self(S),send(S,rw_keep),catch((receive({rw_keep->true},[timeout(0),deadline(not_a_time)]),fail),error(type_error(_,not_a_time),_),true),receive({rw_keep->true},[timeout(0),on_timeout(fail)])",
      "requirements": [
