      "title": "Own node URI without trailing slash; canonical address without caller-namespace restoration",
      "goal": "actors(B),spawn(receive({stop->true}),P,[node($SELF),monitor(true)]),nu_canonical(P,$SELF),send(P,stop),nu_done(P),nu_baseline(B)"
    },
    {
      "id": "NU-002",
