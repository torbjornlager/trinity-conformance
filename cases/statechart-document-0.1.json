      "title": "Mixed XML source kinds are rejected before fetching",
      "transport": "query",
      "goal": "actors(Before),catch((statechart_spawn(Pid,[src_text('<bad/>'),src_uri('http://127.0.0.1:1/never.xml')]),fail),error(domain_error(single_statechart_source_option,_),_),Caught=true),Caught==true,var(Pid),actors(After),sort(Before,Sorted),sort(After,Sorted)"
    },
    {
      "id": "DOC-003",
      "title": "Repeated XML text is rejected before parsing",
      "transport": "query",
      "goal": "actors(Before),catch((statechart_spawn(Pid,[src_text('<bad/>'),src_text('<bad/>')]),fail),error(domain_error(single_statechart_source_option,_),_),Caught=true),Caught==true,var(Pid),actors(After),sort(Before,Sorted),sort(After,Sorted)"
    },
    {
      "id": "DOC-004",
      "title": "Repeated XML URIs are rejected before fetching",
      "transport": "query",
      "goal": "actors(Before),catch((statechart_spawn(Pid,[src_uri('http://127.0.0.1:1/never.xml'),src_uri('http://127.0.0.1:1/never.xml')]),fail),error(domain_error(single_statechart_source_option,_),_),Caught=true),Caught==true,var(Pid),actors(After),sort(Before,Sorted),sort(After,Sorted)"
    }
