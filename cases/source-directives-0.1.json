      "goal": "self(CVSelf),CVSelf!sd_options_1([src_text(':- dynamic sd_dyn/1. sd_ok(yes).'),monitor(true)]),receive({sd_options_1(SDOptions1)->true},[timeout(2),on_timeout(throw(missing_option_data))]),self(S),spawn((sd_ok(V),S!sd_ready(V)),P,SDOptions1),receive({sd_ready(R)->true},[timeout(4),on_timeout(throw(missing_ready))]),R==yes,receive({down(P,P,true)->true},[timeout(4),on_timeout(throw(missing_down))])"
