      "title": "A source directive that fails makes spawn raise directive_failed, or is refused by the sandbox",
      "transport": "query",
      "goal": "self(CVSelf),CVSelf!sd_options_1([src_text(':- fail.')]),receive({sd_options_1(SDOptions1)->true},[timeout(2),on_timeout(throw(missing_option_data))]),self(S),catch(spawn(S!unexpected_creation,P,SDOptions1),E,true),nonvar(E),(E=error(directive_failed(D),_)->D==fail;E=error(permission_error(execute,sandboxed_directive,_),_)),var(P),receive({unexpected_creation->fail},[timeout(0),on_timeout(true)])"
    },
    {
      "id": "SD-002",
      "title": "A failing goal directive after earlier clauses is reported unqualified, or refused by the sandbox",
      "transport": "query",
      "goal": "self(CVSelf),CVSelf!sd_options_1([src_text('sd_fact(a). :- sd_fact(b).')]),receive({sd_options_1(SDOptions1)->true},[timeout(2),on_timeout(throw(missing_option_data))]),catch(spawn(true,P,SDOptions1),E,true),nonvar(E),(E=error(directive_failed(D),_)->D==sd_fact(b);E=error(permission_error(execute,sandboxed_directive,_),_)),var(P)"
    },
    {
